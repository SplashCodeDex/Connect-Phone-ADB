*.ps1   text working-tree-encoding=UTF-8 eol=crlf
*.psm1  text working-tree-encoding=UTF-8 eol=crlf
*.psd1  text working-tree-encoding=UTF-8 eol=crlf
*.xaml  text working-tree-encoding=UTF-8 eol=crlf
*.cs    text working-tree-encoding=UTF-8 eol=crlf
*.xml   text working-tree-encoding=UTF-8 eol=crlf
*.yml   text working-tree-encoding=UTF-8 eol=lf
*.md    text working-tree-encoding=UTF-8 eol=crlf

