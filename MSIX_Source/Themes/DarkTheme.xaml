<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark Theme (Default) -->
    
    <!-- Backgrounds & Borders -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#16121A" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="#2C2C2E" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="#3A3A3C" />
    
    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="White" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A0A0A0" />
    
    <!-- Accent & Status -->
    <SolidColorBrush x:Key="AccentBrush" Color="#6200EE" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#00E676" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF453A" />
    
    <!-- Item Highlights (Selected & Hover) -->
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1F6200EE" />
    <SolidColorBrush x:Key="AccentSelectedBrush" Color="#3D6200EE" />
    <SolidColorBrush x:Key="AccentSelectedHoverBrush" Color="#546200EE" />
    <SolidColorBrush x:Key="AccentSelectedBorderBrush" Color="#806200EE" />
</ResourceDictionary>
