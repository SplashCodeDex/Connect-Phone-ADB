<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark Theme (Strict Minimal Palette) -->
    
    <!-- Backgrounds -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="Transparent" />
    <LinearGradientBrush x:Key="PrimaryBackgroundGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1D1226" Offset="0.0" />
        <GradientStop Color="#09090D" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#2C2C2E" />
    <SolidColorBrush x:Key="TertiaryBackgroundBrush" Color="#3A3A3C" />
    <SolidColorBrush x:Key="BorderBrush" Color="#333333" />
    
    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="White" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A0A0A0" />
    
    <!-- Core Palette (Primary, Secondary, Accent) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#6200EE" />   <!-- Brand, active states -->
    <SolidColorBrush x:Key="SecondaryBrush" Color="#00E676" /> <!-- Success, Folder icons -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF453A" />    <!-- Danger, Warnings, Exits -->
</ResourceDictionary>
