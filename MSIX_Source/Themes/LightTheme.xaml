<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light Theme -->
    
    <!-- Backgrounds & Borders -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="#F2F2F7" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="#E5E5EA" />
    
    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="Black" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#3A3A3C" />
    
    <!-- Accent & Status -->
    <SolidColorBrush x:Key="AccentBrush" Color="#5E5CE6" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#34C759" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF3B30" />
    
    <!-- Item Highlights (Selected & Hover) -->
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1F5E5CE6" />
    <SolidColorBrush x:Key="AccentSelectedBrush" Color="#3D5E5CE6" />
    <SolidColorBrush x:Key="AccentSelectedHoverBrush" Color="#545E5CE6" />
    <SolidColorBrush x:Key="AccentSelectedBorderBrush" Color="#805E5CE6" />
</ResourceDictionary>
