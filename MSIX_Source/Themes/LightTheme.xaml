<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light Theme -->
    
    <!-- Backgrounds & Borders -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#F2F2F7" />
    
    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="Black" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#3A3A3C" />
    
    <!-- Secondary & Status -->
    <SolidColorBrush x:Key="SecondaryBrush" Color="#5E5CE6" />
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF3B30" />
    
    <!-- Item Highlights (Selected & Hover) -->
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#1F5E5CE6" />
    <SolidColorBrush x:Key="SecondarySelectedBrush" Color="#3D5E5CE6" />
    <SolidColorBrush x:Key="SecondarySelectedHoverBrush" Color="#545E5CE6" />
    <SolidColorBrush x:Key="SecondarySelectedBorderBrush" Color="#805E5CE6" />
</ResourceDictionary>
