<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light Theme (Strict Minimal Palette) -->
    
    <!-- Backgrounds -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="Transparent" />
    <RadialGradientBrush x:Key="PrimaryBackgroundGradient" Center="0.5,0.5" RadiusX="1.0" RadiusY="1.0">
        <GradientStop Color="#F5E3F7" Offset="0.0" />
        <GradientStop Color="#FFFFFF" Offset="1.0" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#F2F2F7" />
    <SolidColorBrush x:Key="TertiaryBackgroundBrush" Color="#E5E5EA" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D1D1D6" />
    
    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="Black" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#3A3A3C" />
    
    <!-- Core Palette (Primary, Secondary, Accent) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#5E5CE6" />   <!-- Brand, active states -->
    <SolidColorBrush x:Key="SecondaryBrush" Color="#34C759" /> <!-- Success, Folder icons -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF3B30" />    <!-- Danger, Warnings, Exits -->
    
    <!-- Item Highlights (Selected & Hover - Deeper shade in Light Mode for high visibility) -->
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#3334C759" />
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="#5934C759" />
    <SolidColorBrush x:Key="ItemSelectedHoverBrush" Color="#7334C759" />
    <SolidColorBrush x:Key="ItemSelectedBorderBrush" Color="#B334C759" />
</ResourceDictionary>
