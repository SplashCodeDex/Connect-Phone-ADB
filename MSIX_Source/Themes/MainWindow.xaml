                            </Ellipse.Fill>
                        </Ellipse>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="DeXStudios" FontSize="16" FontFamily="Segoe UI" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="dexstudios@dex.net" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>
                    <Separator Background="{DynamicResource AccentBrush}" Height="1" Margin="0,4,0,8" />
                    
                    <Button Name="btnPopTheme" Style="{StaticResource SpatialListItem}" Margin="0,2">
