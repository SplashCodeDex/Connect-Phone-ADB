                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                
                <Border Grid.Column="1" Background="{DynamicResource AccentBrush}" CornerRadius="20" Padding="14,8">
