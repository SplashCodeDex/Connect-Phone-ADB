                            <TextBlock Text="Toggle Theme" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Name="btnQAAuto" Style="{StaticResource SpatialListItem}" Margin="0,2">
